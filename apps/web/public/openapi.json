{
  "openapi": "3.1.0",
  "info": {
    "title": "RootFetch Public API",
    "version": "1.0.0",
    "description": "Read-only, artifact-backed API surface for MCP discovery, strict outcome contracts, and immutable run artifacts."
  },
  "servers": [
    {
      "url": "https://rootfetch.com"
    }
  ],
  "paths": {
    "/mcp": {
      "get": {
        "summary": "MCP endpoint metadata",
        "operationId": "getMcpMetadata",
        "responses": {
          "200": {
            "description": "MCP endpoint metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/McpMetadata"
                },
                "examples": {
                  "default": {
                    "value": {
                      "name": "RootFetch MCP",
                      "status": "ok",
                      "protocol": "json-rpc-2.0",
                      "transport": "http",
                      "endpoint": "https://rootfetch.com/mcp",
                      "docs_url": "https://rootfetch.com/docs/mcp",
                      "agents_url": "https://rootfetch.com/agents",
                      "first_call_url": "https://rootfetch.com/api/mcp/first-call",
                      "artifact_backed": true,
                      "read_only": true,
                      "no_recompute": true
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "JSON-RPC MCP endpoint",
        "operationId": "postMcpJsonRpc",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              },
              "examples": {
                "initialize": {
                  "summary": "Initialize request",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 1,
                    "method": "initialize",
                    "params": {
                      "protocolVersion": "2024-11-05",
                      "capabilities": {},
                      "clientInfo": {
                        "name": "example-client",
                        "version": "0.1.0"
                      }
                    }
                  }
                },
                "tools_list": {
                  "summary": "Forwarded tools/list request",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 2,
                    "method": "tools/list",
                    "params": {}
                  }
                },
                "tools_call_current_state": {
                  "summary": "Call strict outcome tool",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 3,
                    "method": "tools/call",
                    "params": {
                      "name": "rootfetch.outcome.current_state",
                      "arguments": {}
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcResponse"
                },
                "examples": {
                  "initialize": {
                    "value": {
                      "jsonrpc": "2.0",
                      "id": 1,
                      "result": {
                        "protocolVersion": "2024-11-05",
                        "serverInfo": {
                          "name": "rootfetch-mcp",
                          "version": "1.0.0"
                        },
                        "capabilities": {
                          "tools": {
                            "listChanged": false
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON-RPC request"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/mcp/health": {
      "get": {
        "summary": "MCP health",
        "operationId": "getMcpHealth",
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "examples": {
                  "default": {
                    "value": {
                      "status": "ok",
                      "service": "rootfetch-mcp",
                      "read_only": true,
                      "artifact_backed": true,
                      "run_id": "20260307T231738Z_8a3bde89bd87_rootfetch_model_v1"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/mcp/readyz": {
      "get": {
        "summary": "MCP readiness",
        "operationId": "getMcpReady",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "examples": {
                  "ready": {
                    "value": {
                      "status": "ready",
                      "run_id": "20260307T231738Z_8a3bde89bd87_rootfetch_model_v1",
                      "expected_count": 8,
                      "checked_count": 8,
                      "missing_files": 0
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/rootfetch/artifacts/latest.json": {
      "get": {
        "summary": "Latest immutable run pointer",
        "operationId": "getLatestArtifactPointer",
        "responses": {
          "200": {
            "description": "Latest pointer",
            "content": {
              "application/json": {
                "examples": {
                  "default": {
                    "value": {
                      "run_id": "20260226T090051Z_f229c6bb7bba_rootfetch_model_v1",
                      "snapshot_ts_utc": "2026-02-26T09:00:51Z",
                      "model_version": "rootfetch_model_v1"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rootfetch/artifacts/replay/index.json": {
      "get": {
        "summary": "Replay index",
        "operationId": "getReplayIndex",
        "responses": {
          "200": {
            "description": "Replay runs list"
          }
        }
      }
    },
    "/rootfetch/artifacts/runs/{run_id}/manifest.json": {
      "get": {
        "summary": "Run manifest",
        "operationId": "getRunManifest",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Manifest with file hashes"
          },
          "404": {
            "description": "Run not found"
          }
        }
      }
    },
    "/api/mcp/first-call": {
      "get": {
        "summary": "MCP first-call validator",
        "operationId": "getMcpFirstCall",
        "responses": {
          "200": {
            "description": "First-call validation payload with sample requests and strict outcome response keys"
          },
          "503": {
            "description": "Latest run or bundle unavailable"
          }
        }
      }
    },
    "/api/mcp/stats": {
      "get": {
        "summary": "MCP usage stats",
        "operationId": "getMcpUsageStats",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "default": 7
            },
            "description": "Window size in days"
          }
        ],
        "responses": {
          "200": {
            "description": "Aggregated MCP usage stats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "shared",
                        "local"
                      ]
                    },
                    "generated_at_utc": {
                      "type": "string"
                    },
                    "window_days": {
                      "type": "integer"
                    },
                    "totals": {
                      "type": "object",
                      "properties": {
                        "requests": {
                          "type": "integer"
                        },
                        "rate_limited": {
                          "type": "integer"
                        },
                        "errors": {
                          "type": "integer"
                        }
                      }
                    },
                    "daily": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date_utc": {
                            "type": "string"
                          },
                          "requests": {
                            "type": "integer"
                          },
                          "rate_limited": {
                            "type": "integer"
                          },
                          "errors": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "adoption_kpi": {
                      "type": "object",
                      "properties": {
                        "unique_clients": {
                          "type": "integer"
                        },
                        "repeat_clients": {
                          "type": "integer"
                        },
                        "repeat_client_rate_pct": {
                          "type": "number"
                        },
                        "tool_call_requests": {
                          "type": "integer"
                        },
                        "tool_call_success_rate_pct": {
                          "type": "number"
                        },
                        "initialize_requests": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (admin auth required)"
          }
        },
        "security": [
          {
            "BasicAuth": []
          }
        ]
      }
    },
    "/api/mcp/events": {
      "get": {
        "summary": "MCP recent events",
        "operationId": "getMcpUsageEvents",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "rpc_method",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tool_name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent MCP request events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "generated_at_utc": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "shared",
                        "local"
                      ]
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ts_utc": {
                            "type": "string"
                          },
                          "http_method": {
                            "type": "string"
                          },
                          "rpc_method": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "tool_name": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "status": {
                            "type": "integer"
                          },
                          "duration_ms": {
                            "type": "integer"
                          },
                          "rate_limited": {
                            "type": "boolean"
                          },
                          "kind": {
                            "type": "string"
                          },
                          "ip_hash": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (admin auth required)"
          }
        },
        "security": [
          {
            "BasicAuth": []
          }
        ]
      }
    },
    "/api/mcp/public-stats": {
      "get": {
        "summary": "Public MCP usage stats",
        "operationId": "getMcpPublicUsageStats",
        "parameters": [
          {
            "in": "query",
            "name": "days",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "default": 7
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Anonymized MCP usage stats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "shared",
                        "local"
                      ]
                    },
                    "generated_at_utc": {
                      "type": "string"
                    },
                    "window_days": {
                      "type": "integer"
                    },
                    "totals": {
                      "type": "object",
                      "properties": {
                        "requests": {
                          "type": "integer"
                        },
                        "rate_limited": {
                          "type": "integer"
                        },
                        "errors": {
                          "type": "integer"
                        }
                      }
                    },
                    "by_status": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    },
                    "by_http_method": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    },
                    "by_rpc_method": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    },
                    "by_kind": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    },
                    "by_tool": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    },
                    "daily": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date_utc": {
                            "type": "string"
                          },
                          "requests": {
                            "type": "integer"
                          },
                          "rate_limited": {
                            "type": "integer"
                          },
                          "errors": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "backend": {
                      "type": "string",
                      "enum": [
                        "configured",
                        "local",
                        "error"
                      ]
                    },
                    "note": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/public-events": {
      "get": {
        "summary": "Public MCP usage events",
        "operationId": "getMcpPublicUsageEvents",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "in": "query",
            "name": "rpc_method",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tool_name",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Anonymized recent MCP events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "generated_at_utc": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "shared",
                        "local"
                      ]
                    },
                    "backend": {
                      "type": "string",
                      "enum": [
                        "configured",
                        "local",
                        "error"
                      ]
                    },
                    "note": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ts_utc": {
                            "type": "string"
                          },
                          "http_method": {
                            "type": "string"
                          },
                          "rpc_method": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "tool_name": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "status": {
                            "type": "integer"
                          },
                          "duration_ms": {
                            "type": "integer"
                          },
                          "rate_limited": {
                            "type": "boolean"
                          },
                          "kind": {
                            "type": "string"
                          },
                          "limiter_mode": {
                            "type": "string",
                            "enum": [
                              "shared",
                              "local"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/mcp/healthz": {
      "get": {
        "summary": "MCP healthz",
        "operationId": "getMcpHealthz",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "examples": {
                  "ready": {
                    "value": {
                      "status": "ready",
                      "run_id": "20260307T231738Z_8a3bde89bd87_rootfetch_model_v1",
                      "expected_count": 8,
                      "checked_count": 8,
                      "missing_files": 0
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/api/mcp/outcome-schemas": {
      "get": {
        "summary": "Outcome tool contracts",
        "operationId": "getMcpOutcomeSchemas",
        "responses": {
          "200": {
            "description": "Machine-readable contracts for outcome tools",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutcomeToolContracts"
                },
                "examples": {
                  "default": {
                    "value": {
                      "generated_at_utc": "2026-03-11T00:00:00.000Z",
                      "schema_version": "1.0",
                      "tools": {
                        "rootfetch.outcome.current_state": {
                          "description": "Strict state snapshot for one immutable run.",
                          "required_top_level": [
                            "outcome",
                            "schema_version",
                            "run_id",
                            "regime",
                            "concentration",
                            "coverage",
                            "volatility",
                            "top_anomalies",
                            "evidence"
                          ],
                          "evidence_required": true
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/probe": {
      "post": {
        "summary": "Run MCP probe sequence",
        "operationId": "postMcpProbe",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "examples": {
                "default": {
                  "value": {}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Probe completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/McpProbeResult"
                },
                "examples": {
                  "success": {
                    "value": {
                      "ok": true,
                      "generated_at_utc": "2026-03-11T00:00:00.000Z",
                      "duration_ms": 84,
                      "statuses": {
                        "initialize": 200,
                        "tools_list": 200,
                        "current_state": 200
                      },
                      "endpoint": "https://rootfetch.com/mcp"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Probe failed"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "McpMetadata": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "transport": {
            "type": "string"
          },
          "endpoint": {
            "type": "string",
            "format": "uri"
          },
          "docs_url": {
            "type": "string",
            "format": "uri"
          },
          "artifact_backed": {
            "type": "boolean"
          },
          "read_only": {
            "type": "boolean"
          },
          "no_recompute": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "status",
          "protocol",
          "transport",
          "endpoint",
          "docs_url"
        ]
      },
      "JsonRpcRequest": {
        "type": "object",
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": [
              "2.0"
            ]
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "method": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "jsonrpc",
          "method"
        ],
        "additionalProperties": false
      },
      "JsonRpcResponse": {
        "type": "object",
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": [
              "2.0"
            ]
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "type": "object",
            "additionalProperties": true
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "jsonrpc"
        ]
      },
      "OutcomeToolContracts": {
        "type": "object",
        "properties": {
          "generated_at_utc": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "tools": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "required_top_level": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence_required": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "required": [
          "generated_at_utc",
          "schema_version",
          "tools"
        ]
      },
      "McpProbeResult": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "generated_at_utc": {
            "type": "string"
          },
          "duration_ms": {
            "type": "integer"
          },
          "statuses": {
            "type": "object",
            "properties": {
              "initialize": {
                "type": "integer"
              },
              "tools_list": {
                "type": "integer"
              },
              "current_state": {
                "type": "integer"
              }
            },
            "required": [
              "initialize",
              "tools_list",
              "current_state"
            ]
          },
          "endpoint": {
            "type": "string",
            "format": "uri"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "generated_at_utc"
        ]
      }
    },
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Admin telemetry endpoints require HTTP Basic Auth."
      }
    }
  }
}
