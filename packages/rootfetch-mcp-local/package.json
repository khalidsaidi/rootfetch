{
  "name": "@khalidsaidi/rootfetch-mcp",
  "version": "0.2.1",
  "description": "MCP server for RootFetch: size, growth, operator, abuse signals and history for ~1,080 domain extensions (TLDs), from ICANN zone files.",
  "keywords": [
    "agents",
    "dns",
    "domain-extensions",
    "domain-statistics",
    "domains",
    "icann",
    "json-rpc",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "rootfetch",
    "stdio",
    "tld",
    "zone-files"
  ],
  "license": "MIT",
  "homepage": "https://rootfetch.com/mcp.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalidsaidi/rootfetch.git",
    "directory": "packages/rootfetch-mcp-local"
  },
  "bugs": {
    "url": "https://github.com/khalidsaidi/rootfetch/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "private": false,
  "mcpName": "io.github.khalidsaidi/rootfetch",
  "bin": {
    "rootfetch-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "quick-test": "node scripts/quick-test.mjs",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"const fs=require('fs');const p='dist/cli.js';const c=fs.readFileSync(p,'utf8');if(!c.startsWith('#!')){fs.writeFileSync(p,'#!/usr/bin/env node\\n'+c);}\"",
    "prepublishOnly": "npm run build",
    "lint": "echo 'lint not configured'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'no tests'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
