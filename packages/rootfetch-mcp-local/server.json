{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.khalidsaidi/rootfetch",
  "title": "RootFetch",
  "description": "Size, growth, owner and abuse signals for ~1,080 domain extensions (TLDs), from ICANN zone files.",
  "version": "0.2.1",
  "repository": {
    "source": "github",
    "url": "https://github.com/khalidsaidi/rootfetch",
    "subfolder": "packages/rootfetch-mcp-local"
  },
  "websiteUrl": "https://rootfetch.com/mcp.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@khalidsaidi/rootfetch-mcp",
      "version": "0.2.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.rootfetch.com/mcp"
    }
  ],
  "icons": [
    {
      "src": "https://rootfetch.com/og/logo.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ]
}
