{
  "hosting": [
    {
      "target": "api",
      "public": "docs/hosting/api",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/**",
          "run": {
            "serviceId": "rootfetch-web",
            "region": "us-central1"
          }
        }
      ]
    },
    {
      "target": "mcp",
      "public": "docs/hosting/mcp",
      "ignore": [
        "firebase.json",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "/mcp",
          "type": 301
        },
        {
          "source": "/health",
          "destination": "/mcp/health",
          "type": 307
        },
        {
          "source": "/health/",
          "destination": "/mcp/health",
          "type": 307
        },
        {
          "source": "/readyz",
          "destination": "/mcp/readyz",
          "type": 307
        },
        {
          "source": "/readyz/",
          "destination": "/mcp/readyz",
          "type": 307
        }
      ],
      "rewrites": [
        {
          "source": "/mcp",
          "run": {
            "serviceId": "rootfetch-web",
            "region": "us-central1"
          }
        },
        {
          "source": "/mcp/**",
          "run": {
            "serviceId": "rootfetch-web",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/**",
          "run": {
            "serviceId": "rootfetch-web",
            "region": "us-central1"
          }
        },
        {
          "source": "/air.json",
          "run": {
            "serviceId": "rootfetch-web",
            "region": "us-central1"
          }
        },
        {
          "source": "/openapi.json",
          "run": {
            "serviceId": "rootfetch-web",
            "region": "us-central1"
          }
        },
        {
          "source": "/ai-plugin.json",
          "run": {
            "serviceId": "rootfetch-web",
            "region": "us-central1"
          }
        },
        {
          "source": "/.well-known/**",
          "run": {
            "serviceId": "rootfetch-web",
            "region": "us-central1"
          }
        }
      ]
    }
  ]
}
