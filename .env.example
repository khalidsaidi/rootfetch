CZDS_USERNAME=your_icann_username
CZDS_PASSWORD=your_icann_password
# Optional when your account enforces TOTP MFA:
# CZDS_TOTP_SECRET=base32_totp_seed

# Baseline / ingestion controls
ROOTFETCH_MAX_WORKERS=8
ROOTFETCH_HTTP_TIMEOUT=120
ROOTFETCH_RETRY_MAX=8
ROOTFETCH_LOG_EVERY=25

# Optional MCP live-check settings (recommended in local .env.mcp instead of .env):
# ROOTFETCH_MCP_TOKEN=your_vercel_mcp_bearer_token
# ROOTFETCH_MCP_ORIGIN=https://rootfetch.vercel.app
# ROOTFETCH_MCP_URL=https://rootfetch.vercel.app/api/mcp
